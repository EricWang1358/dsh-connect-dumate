{
  "name": "dsh-connect-dumate",
  "displayName": "DSH Connect DuMate",
  "description": "将本机登录的百度搭子（DuMate）接入 DeepSeek Harness：自动读取桌面端登录态与模型清单、进程内 OpenAI 兼容 Loopback Shim（真 SSE 流式 / 工具调用 / 思考档位映射）、独立产品积分看板与自动签到。",
  "version": "1.0.0",
  "author": "EricWang1358",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dumate",
    "qianfan",
    "baidu",
    "model-provider",
    "points"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/dumate-auth.js && node --check lib/dumate-catalog.js && node --check lib/dumate-shim.js && node --check lib/client.js && node --check scripts/measure-rates.mjs && node --check scripts/check-pii.mjs",
    "check:pii": "node scripts/check-pii.mjs",
    "test": "node --test test/plugin.test.mjs",
    "prepublishOnly": "npm run check && npm run check:pii && npm run test",
    "measure:rates": "node scripts/measure-rates.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EricWang1358/dsh-connect-dumate.git"
  },
  "homepage": "https://github.com/EricWang1358/dsh-connect-dumate#readme",
  "bugs": {
    "url": "https://github.com/EricWang1358/dsh-connect-dumate/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.88.0 || >=1.0.0-0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
